<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="CircularMetricView">
        <attr name="metricAccentColor" format="color" />
        <attr name="metricTrackColor" format="color" />
        <attr name="metricProgress" format="float" />
        <attr name="metricStrokeWidth" format="dimension" />
        <attr name="metricShowTipDot" format="boolean" />
    </declare-styleable>

    <declare-styleable name="SparklineView">
        <attr name="sparklineColor" format="color" />
        <attr name="sparklineFillAlpha" format="float" />
        <attr name="sparklineStrokeWidth" format="dimension" />
    </declare-styleable>
</resources>
