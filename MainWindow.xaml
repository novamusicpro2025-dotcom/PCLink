<Window x:Class="PcClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PC Master - Cockpit Control Center" Height="720" Width="1100"
        Icon="pcmaster.ico"
        MinHeight="540" MinWidth="420"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        Loaded="Window_Loaded"
        AllowDrop="True"
        Drop="FilesPanel_Drop"
        DragOver="FilesPanel_DragOver">

    <Window.Resources>
        <!-- === MOBILE DARK COCKPIT THEME PALETTE === -->
        <SolidColorBrush x:Key="MainBg" Color="#050A14"/>
        <SolidColorBrush x:Key="SidebarBg" Color="#07101F"/>
        <SolidColorBrush x:Key="CardBg" Color="#0B1528"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1A2D4A"/>
        <SolidColorBrush x:Key="TextMain" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A9BB5"/>
        <SolidColorBrush x:Key="TextDeepDim" Color="#4A5F80"/>

        <!-- Cyber Neon Accents matching Mobile App -->
        <SolidColorBrush x:Key="AccentBlue" Color="#00D2FF"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#BF5AF2"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF88"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9F0A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF453A"/>
        <SolidColorBrush x:Key="AccentPink" Color="#FF5E7E"/>

        <!-- Pod Card Border Gradient -->
        <LinearGradientBrush x:Key="GlassBorder" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4000D2FF" Offset="0"/>
            <GradientStop Color="#1A2D4A" Offset="0.45"/>
            <GradientStop Color="#25162744" Offset="1"/>
        </LinearGradientBrush>

        <!-- Specular Highlight Top Edge -->
        <LinearGradientBrush x:Key="GlassTopSpecular" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A00D2FF" Offset="0"/>
            <GradientStop Color="#3300D2FF" Offset="0.5"/>
            <GradientStop Color="#1A00D2FF" Offset="1"/>
        </LinearGradientBrush>

        <!-- Cockpit Pod Card Fill -->
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EA0E1A30" Offset="0"/>
            <GradientStop Color="#F0091325" Offset="1"/>
        </LinearGradientBrush>

        <!-- Sidebar Deep Surface Fill -->
        <LinearGradientBrush x:Key="SidebarGlass" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#F507101F" Offset="0"/>
            <GradientStop Color="#EA050A14" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="NeonBtnGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00D2FF" Offset="0"/>
            <GradientStop Color="#0077B6" Offset="1"/>
        </LinearGradientBrush>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- Cockpit Sidebar Button Style -->
        <Style x:Key="SidebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A9BB5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="12" SnapsToDevicePixels="True" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" Margin="8,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#15243C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1A2D4A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="border" Property="Background" Value="#162640"/>
                                <Setter Property="Foreground" Value="#00D2FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#4000D2FF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="16" Color="#00D2FF" Opacity="0.3" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel Entrance Animation Style -->
        <Style x:Key="PanelStyle" TargetType="Grid">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35"/>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="15" To="0" Duration="0:0:0.35">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Mobile Cockpit Card Pod Style -->
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassFill}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="22" Color="#000000" ShadowDepth="2" Opacity="0.55"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cockpit Switch / Flat Toggle -->
        <Style x:Key="FlatToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bg" Width="46" Height="24" Background="#0E1A30" CornerRadius="12" BorderBrush="#1A2D4A" BorderThickness="1">
                            <Ellipse x:Name="dot" Width="18" Height="18" Fill="#4A5F80" HorizontalAlignment="Left" Margin="3,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="dotTransform" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter TargetName="dot" Property="Fill" Value="#050A14"/>
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="14" Color="#00D2FF" ShadowDepth="0" Opacity="0.6"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cockpit Slider Style -->
        <Style x:Key="GlassSlider" TargetType="Slider">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border x:Name="TrackBackground" Height="5" Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="0.8" CornerRadius="2.5" VerticalAlignment="Center" Margin="5,0"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="Transparent" BorderThickness="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="{StaticResource AccentBlue}" CornerRadius="2.5"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse Width="18" Height="18" Fill="#00D2FF" Stroke="#FFFFFF" StrokeThickness="1.5">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="12" Color="#00D2FF" Opacity="0.7" ShadowDepth="0"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tactile Cockpit Button -->
        <Style x:Key="NeonBtn" TargetType="Button">
            <Setter Property="Background" Value="#101C30"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#1A2D4A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBg" Background="{TemplateBinding Background}" CornerRadius="10"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBg" Property="Background" Value="#182C4E"/>
                                <Setter TargetName="btnBg" Property="BorderBrush" Value="#00D2FF"/>
                                <Setter Property="Foreground" Value="#00D2FF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBg" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Cockpit Container -->
    <Border CornerRadius="24" MouseLeftButtonDown="Window_MouseLeftButtonDown" ClipToBounds="True" BorderThickness="1.2">
        <Border.Background>
            <SolidColorBrush Color="#050A14"/>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#4000D2FF" Offset="0"/>
                <GradientStop Color="#1A2D4A" Offset="0.4"/>
                <GradientStop Color="#25BF5AF2" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Grid>
            <!-- High-Performance Ambient Cockpit Background Gradients (0% CPU overhead, 120 FPS Smooth) -->
            <Grid x:Name="BackgroundMeshGrid" Opacity="0.75" IsHitTestVisible="False">
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="750" Height="600" Margin="-150,-150,0,0">
                    <Border.Background>
                        <RadialGradientBrush Center="0.35,0.35" RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#1800D2FF" Offset="0"/>
                            <GradientStop Color="#0700D2FF" Offset="0.45"/>
                            <GradientStop Color="Transparent" Offset="0.85"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="750" Height="600" Margin="0,0,-150,-150">
                    <Border.Background>
                        <RadialGradientBrush Center="0.65,0.65" RadiusX="0.65" RadiusY="0.65">
                            <GradientStop Color="#15BF5AF2" Offset="0"/>
                            <GradientStop Color="#05BF5AF2" Offset="0.45"/>
                            <GradientStop Color="Transparent" Offset="0.85"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="550" Height="400">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" RadiusX="0.6" RadiusY="0.6">
                            <GradientStop Color="#0C00FF88" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="0.7"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Grid>

            <!-- Master Gaming Mode Glow Overlay -->
            <Border x:Name="HyperGlowOverlay" Opacity="0" IsHitTestVisible="False" CornerRadius="24">
                <Border.Background>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#20BF5AF2" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#9000D2FF" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="0.5"/>
                        <GradientStop Color="#90BF5AF2" Offset="1"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>2.5</Border.BorderThickness>
            </Border>

            <!-- Main Full UI Grid -->
            <Grid x:Name="FullUIGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar Navigation Dock -->
                <Border Grid.Column="0" Background="{StaticResource SidebarGlass}" BorderBrush="#162744" BorderThickness="0,0,1,0" CornerRadius="24,0,0,24">
                    <Grid Margin="0,15,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Brand Logo -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,0,14,16" HorizontalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                        <GradientStop Color="#BF5AF2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="16" Color="#00D2FF" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <TextBlock Text="PC" Foreground="White" FontSize="15" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                <TextBlock Text="PC MASTER" Foreground="White" FontSize="15" FontWeight="Black"/>
                                <TextBlock Text="COCKPIT OS | MOBILE LINKED" Foreground="{StaticResource AccentBlue}" FontSize="8.5" FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Navigation Items -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Button x:Name="NavDashboard" Style="{StaticResource SidebarBtn}" Tag="Selected" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4CA;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavMirror" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4F1;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Liquid Mirror" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavFiles" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F4C1;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AirDrop Files" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavRemote" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F680;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="App Library" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavMacros" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x26A1;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Pro Optimizer" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavMedia" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F3B5;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Media Studio" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavNotifications" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                             <ColumnDefinition Width="Auto"/>
                                             <ColumnDefinition Width="*"/>
                                             <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="&#x1F514;" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="Notifications" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                        <Border Grid.Column="2" x:Name="NotifBadgeBorder" Background="#FF453A" CornerRadius="8" Padding="6,1" Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                            <TextBlock x:Name="NotifBadgeCount" Text="0" Foreground="White" FontSize="9.5" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <Button x:Name="NavSystem" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2699;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Hardware &amp; Power" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="NavSettings" Style="{StaticResource SidebarBtn}" Click="NavBtn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x1F6E0;" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Preferences" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom Companion Quick Pod -->
                        <Border Grid.Row="2" CornerRadius="14" Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" Margin="10,8,10,0" Padding="10,8">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F4F1;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="PHONE HUB" Foreground="{StaticResource TextDim}" FontSize="9.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Border HorizontalAlignment="Right" Background="#1800D2FF" CornerRadius="8" Padding="6,1">
                                        <TextBlock Text="ACTIVE" Foreground="{StaticResource AccentBlue}" FontSize="8.5" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                                <UniformGrid Columns="4">
                                    <Button Content="&#x1F4F1;" ToolTip="Liquid Mirror" Click="NavBtn_Click" Tag="{Binding ElementName=NavMirror}" Style="{StaticResource NeonBtn}" Padding="2,4" Margin="1.5" FontSize="11"/>
                                    <Button Content="&#x1F512;" ToolTip="Lock PC" Click="RemoteCmd_Click" Tag="lock" Style="{StaticResource NeonBtn}" Padding="2,4" Margin="1.5" FontSize="11"/>
                                    <Button Content="&#x1F507;" ToolTip="Mute Audio" Click="RemoteCmd_Click" Tag="mute" Style="{StaticResource NeonBtn}" Padding="2,4" Margin="1.5" FontSize="11"/>
                                    <Button Content="&#x26A1;" ToolTip="RAM Boost" Click="Macro_Click" Tag="boostram" Style="{StaticResource NeonBtn}" Padding="2,4" Margin="1.5" FontSize="11"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content ScrollViewer -->
                <ScrollViewer x:Name="MainContentScrollViewer" Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="False"
                              PanningMode="VerticalOnly"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
                    <Grid Margin="18">

                        <!-- ============================================== -->
                        <!-- 1. DASHBOARD PANEL (Liquid Mirror Glass) -->
                        <!-- ============================================== -->
                        <Grid x:Name="DashboardPanel" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Mobile Dynamic Island Cockpit Top Bar (Row 0) -->
                            <Border Grid.Row="0" CornerRadius="18" Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" Padding="14,10" Margin="0,0,0,18">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="22" Color="#000000" ShadowDepth="2" Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: PC Master Brand & Pulse -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="36" Height="36" CornerRadius="12" BorderBrush="#1A2D4A" BorderThickness="1" Margin="0,0,12,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#2500D2FF" Offset="0"/>
                                                    <GradientStop Color="#25BF5AF2" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <TextBlock Text="&#x26A1;" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="PC MASTER" FontSize="16" FontWeight="Black">
                                                <TextBlock.Foreground>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                                        <GradientStop Color="#BF5AF2" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </TextBlock.Foreground>
                                            </TextBlock>
                                            <TextBlock Text="COCKPIT OS | REMOTE CONTROL CENTER" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextDim}" Margin="1,1,0,0"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Center: Dynamic Island Connection & Ping Pill -->
                                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="14" Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" Padding="14,6">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="ConnectionIndicator" Width="9" Height="9" Fill="{StaticResource AccentRed}" Margin="0,0,8,0">
                                                <Ellipse.Effect>
