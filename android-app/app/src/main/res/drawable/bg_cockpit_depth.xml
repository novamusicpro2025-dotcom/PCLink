<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#020408" android:centerColor="#04070F" android:endColor="#010204" />
        </shape>
    </item>
    <item android:gravity="top|start" android:width="260dp" android:height="260dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="180dp" android:startColor="#1200D2FF" android:endColor="#00000000" />
        </shape>
    </item>
    <item android:gravity="bottom|end" android:width="300dp" android:height="300dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="200dp" android:startColor="#0F6C5CE7" android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
