<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_pod_bg"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️"
            android:textSize="26sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Privacy Policy"
                android:textColor="#00FF88"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC Master Pro • 100% Zero Data Collection Guarantee"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Highlighted Security Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_glass_bg"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="7dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒"
            android:textSize="14sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="100% ZERO DATA COLLECTED • 100% LOCAL LAN ONLY"
            android:textColor="#00FF88"
            android:textSize="10.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Official Online Privacy Policy Web Link Button -->
    <LinearLayout
        android:id="@+id/btnOpenOnlinePrivacyPolicy"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/btn_connect_bg"
        android:orientation="horizontal"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌐"
            android:textSize="15sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Privacy Policy - PCLink &amp; PC Master"
            android:textColor="#FFFFFF"
            android:textSize="12.5sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1F293D"
        android:layout_marginBottom="10dp" />

    <!-- Scrollable Privacy Policy Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <!-- SECTION 1: ZERO DATA COLLECTION GUARANTEE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1. 100% Zero Data Collection Guarantee"
                    android:textColor="#00FF88"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• PC Master is engineered with an uncompromising privacy-first architecture.\n• We do NOT collect, harvest, monitor, record, transmit, store, sell, or analyze ANY personal information, device data, keystrokes, screen recordings, network traffic, or user behavior.\n• We do not own, maintain, or connect to any cloud databases or external telemetry servers. The application functions entirely offline over your local Wi-Fi."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 2: ZERO TRACKERS & ANALYTICS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2. Zero Third-Party SDKs, Trackers &amp; Ads"
                    android:textColor="#00D2FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• NO Analytics: We do not integrate Google Analytics, Firebase Analytics, Mixpanel, Flurry, or any tracking SDK.\n• NO Crash Logging Servers: No stack traces or memory dumps are ever sent to remote services (no Crashlytics, Sentry, or Bugsnag).\n• NO Advertising: The application is 100% ad-free and contains zero marketing trackers or advertiser IDs.\n• NO Social Trackers: No Facebook, Twitter, or third-party web beacons are present."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 3: NO ACCOUNTS OR REGISTRATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3. No Accounts, Profiles, or Sign-ups"
                    android:textColor="#FFD600"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• You are NEVER required to create an account, register, sign in, or provide personal details.\n• We do NOT collect your name, email address, phone number, location, contacts, or passwords.\n• No financial data, billing info, or payment details are ever requested or processed."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 4: 100% LOCAL PEER-TO-PEER LAN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4. 100% Local Peer-to-Peer (LAN) Network"
                    android:textColor="#00E5FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Every single communication packet—including mouse cursor moves, mouse clicks, keystrokes, live screen video frames, phone cast video buffers, file transfers, and hardware telemetry—travels EXCLUSIVELY across your private local Wi-Fi router or phone mobile hotspot directly between your Android phone and Windows PC.\n• Zero Cloud Servers: No packet ever routes through the public internet, cloud relays, or external proxies.\n• If your home internet service is disconnected, PC Master continues to operate with 100% functionality as long as your phone and PC are connected to the same local router or hotspot."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 5: ON-DEVICE LOCAL STORAGE BREAKDOWN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5. Exact Local Storage Breakdown"
                    android:textColor="#B388FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="The application stores ONLY the following minimal configuration data strictly within your phone's private on-device SharedPreferences:\n• server_ip: The local IP address of your PC (e.g., 192.168.1.5).\n• server_port: The local port number (default 8080).\n• auth_token: An optional local security token if you enable password protection on your desktop server.\n• is_bw_theme: A boolean flag remembering whether you chose Black &amp; White theme mode.\n• stream_quality: Your preferred stream quality preset (1080p, 4K, 720p).\n\nThis data NEVER leaves your phone's sandbox. Clearing the app's data in Android Settings or uninstalling the app permanently deletes 100% of this information."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 6: EXHAUSTIVE PERMISSIONS BREAKDOWN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6. Exhaustive Android Permissions Breakdown"
                    android:textColor="#FF6D00"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="We disclose every single Android permission requested by PC Master, why it is needed, and how your privacy is guaranteed:\n\n• INTERNET: Used exclusively to establish local socket communication (HTTP/WebSocket) with your PC server on your local Wi-Fi network. Does not connect to external websites or cloud services.\n\n• ACCESS_NETWORK_STATE &amp; ACCESS_WIFI_STATE: Used to determine whether your phone is connected to Wi-Fi and discover your PC's IP on the local subnet automatically.\n\n• CAMERA: Used exclusively to scan the pairing QR code displayed on your PC screen. Camera frames are processed strictly in memory on-device by the barcode engine; no photos or videos are ever saved or transmitted.\n\n• FOREGROUND_SERVICE &amp; MEDIA_PROJECTION: Required by Android OS to run screen capture when you tap 'START' under 'Phone Screen Cast to PC'. Casting is initiated only with explicit user permission via the Android system dialog. Frames are sent directly to your local PC server over LAN, are never saved to disk, and stop immediately when you tap 'STOP'.\n\n• POST_NOTIFICATIONS: Used solely to display the persistent notification while Phone Screen Cast is running, as required by Android OS rules. No advertising or marketing notifications are ever sent.\n\n• READ_EXTERNAL_STORAGE &amp; WRITE_EXTERNAL_STORAGE / Scoped Storage: Used solely when you choose to download a file from your PC to your phone's Download/ folder, or choose a file to upload from your phone to your PC. The app never scans, catalogs, or reads any files other than those you explicitly select.\n\n• VIBRATE: Provides tactile haptic feedback on button presses. Zero data generated."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 7: KEYSTROKE & INPUT PRIVACY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="7. Keystroke &amp; Remote Input Privacy"
                    android:textColor="#00FF88"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Keystrokes sent via the Quick Remote Text Bar or virtual keyboard are transmitted directly to your local PC via HTTP POST to type onto your Windows screen.\n• PC Master contains NO keylogging functionality. We never record, log, or store your typed words, passwords, or clipboard text."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 8: FILE TRANSFER PRIVACY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8. Wireless File Transfer Privacy"
                    android:textColor="#00D2FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Files transferred via the Remote File Manager are streamed directly peer-to-peer over your private Wi-Fi network between your phone and PC.\n• No file contents or file names are ever inspected, indexed, or shared with third parties."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 9: DATA DELETION & RETENTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="9. Data Retention &amp; Permanent Deletion"
                    android:textColor="#FF4081"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Since no user data exists on any external server, there is no remote account or profile to delete.\n• You have total control: Clearing app data in Android System Settings or uninstalling the app permanently purges all local settings from your smartphone."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 10: CHILDREN'S PRIVACY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10. Children's Privacy Protection (COPPA)"
                    android:textColor="#FFD600"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• PC Master does not collect personal information from anyone, including children under 13. The app is fully compliant with the Children's Online Privacy Protection Act (COPPA) and international standards."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 11: GDPR & CCPA COMPLIANCE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11. International Privacy Compliance (GDPR &amp; CCPA)"
                    android:textColor="#00FF88"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• GDPR (General Data Protection Regulation): Built on the core principle of Data Minimization (Article 5) and Privacy by Design (Article 25). Zero personal data is processed or stored.\n• CCPA (California Consumer Privacy Act): We do not sell, share, or disclose personal information because zero personal data is collected."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 12: POLICY PERMANENCE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12. Policy Permanence &amp; Transparency"
                    android:textColor="#00D2FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Any future updates to this policy will be clearly documented inside the application. Because our architecture is strictly local peer-to-peer, our commitment to zero data collection remains permanent."
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- SECTION 13: CONTACT & INQUIRIES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="13. Security Verification &amp; Inquiries"
                    android:textColor="#B388FF"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="If you have questions, feedback, bug reports, or would like to independently audit PC Master's local peer-to-peer network traffic, you can monitor packets using tools like Wireshark on your local network to verify that zero external connections are ever initiated.\n\nPrivacy &amp; Bug Support Email: novamusicpro2025@gmail.com\nDeveloper: Antigravity PC Master Team"
                    android:textColor="#C9D1D9"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Online Link in Section 13 -->
                <LinearLayout
                    android:id="@+id/btnOpenOnlinePrivacyPolicyBottom"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/btn_scan_bg"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔗"
                        android:textSize="14sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Open Official Hosted Policy (GitHub)"
                        android:textColor="#00D2FF"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnPrivacyPolicyClose"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="✕ CLOSE PRIVACY POLICY"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/btn_connect_bg"
        android:layout_marginTop="8dp" />

</LinearLayout>
