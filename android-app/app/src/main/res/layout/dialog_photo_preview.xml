<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#060A14">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/llPhotoHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#151E2E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageButton
            android:id="@+id/btnClosePhotoPreview"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/key_btn_bg"
            android:src="@drawable/ic_back_nav"
            app:tint="#FFFFFF"
            android:contentDescription="Close Preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvPhotoPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Photo Preview"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvPhotoPreviewSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="4.2 MB • PC Master Viewer"
                android:textColor="#00D2FF"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Content: Loading Spinner & Image -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llPhotoHeader"
        android:layout_above="@+id/llPhotoBottomBar">

        <ImageView
            android:id="@+id/ivPhotoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="Photo Preview" />

        <ProgressBar
            android:id="@+id/pbPhotoLoading"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00D2FF" />
    </FrameLayout>

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:id="@+id/llPhotoBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#151E2E"
        android:orientation="vertical"
        android:padding="14dp">

        <Button
            android:id="@+id/btnDownloadPhoto"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⬇ SAVE TO PHONE GALLERY"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_connect_bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Saves full resolution image to Pictures/PCMaster"
            android:textColor="#8A9BB5"
            android:textSize="10sp"
            android:layout_marginTop="5dp" />
    </LinearLayout>

</RelativeLayout>
