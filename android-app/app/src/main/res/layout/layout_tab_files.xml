<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_cockpit_depth"
    android:paddingHorizontal="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Header Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_nav_files"
            app:tint="#00D2FF" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fast Wireless Drop"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AirDrop-style phone to PC file transfer"
                android:textColor="#6E829F"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Upload Card Button -->
    <LinearLayout
        android:id="@+id/btnUploadFile"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_pod_bg"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:layout_marginBottom="10dp">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/badge_glow_cyan"
            android:layout_marginEnd="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_rocket_actions"
                app:tint="#00D2FF" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upload to PC Hub"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Send photos, videos, or documents to PC"
                android:textColor="#8A9BB5"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#00D2FF"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Upload Progress Bar -->
    <ProgressBar
        android:id="@+id/pbUpload"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone"
        android:progressTint="#00D2FF"
        android:layout_marginBottom="8dp" />

    <!-- Shared Files Header & Navigation Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="8dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFolderBack"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="⬅ BACK"
                    android:textSize="10.5sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/btn_scan_bg"
                    android:backgroundTint="#2500D2FF"
                    android:paddingHorizontal="10dp"
                    android:layout_marginEnd="8dp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PC FILE EXPLORER"
                    android:textColor="#00D2FF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

            <Button
                android:id="@+id/btnRefreshFiles"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="↻ REFRESH"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#00D2FF"
                android:background="@drawable/btn_scan_bg"
                android:paddingHorizontal="10dp" />
        </RelativeLayout>

        <!-- Current Path Breadcrumb -->
        <TextView
            android:id="@+id/tvCurrentFolderPath"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Root: PC Drives (C:, D:)"
            android:textColor="#8A9BB5"
            android:textSize="10sp"
            android:ellipsize="start"
            android:singleLine="true"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <!-- Shared Files ListView Container -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_glass_bg"
        android:padding="8dp">

        <ListView
            android:id="@+id/lvSharedFiles"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="4dp"
            android:scrollbars="vertical" />
    </FrameLayout>

</LinearLayout>
