<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:angle="270"
                android:startColor="#1E283F"
                android:centerColor="#141D30"
                android:endColor="#0E1624" />
            <stroke
                android:width="1dp"
                android:color="#3A4D73" />
        </shape>
    </item>
</layer-list>
