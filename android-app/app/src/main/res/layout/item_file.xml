<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_pod_bg"
    android:padding="10dp">

    <FrameLayout
        android:id="@+id/flIconBg"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/badge_glow_cyan"
        android:layout_marginEnd="10dp">

        <TextView
            android:id="@+id/tvFileIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="📄"
            android:textSize="15sp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/tvFileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="document.pdf"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/tvFileSize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="14.2 MB"
            android:textColor="#8A9BB5"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnPreviewFile"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="52dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:includeFontPadding="false"
            android:text="👁 VIEW"
            android:textColor="#00FF88"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/key_btn_bg"
            android:layout_marginEnd="5dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnDownloadFile"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:minWidth="52dp"
            android:minHeight="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:includeFontPadding="false"
            android:text="GET ⬇"
            android:textColor="#00D2FF"
            android:textSize="9.5sp"
            android:textStyle="bold"
            android:background="@drawable/btn_scan_bg" />
    </LinearLayout>
</LinearLayout>
