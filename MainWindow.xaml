                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="120" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Info}" Foreground="{StaticResource AccentPurple}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="6,0"/>
                                                        <Button Grid.Column="2" Content="KILL" Click="KillProcess_Click" Tag="{Binding Pid}" Style="{StaticResource NeonBtn}" Padding="6,1" FontSize="9" FontWeight="Black" BorderBrush="{StaticResource AccentRed}" Foreground="{StaticResource AccentRed}" Height="20"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: Cockpit Memo & Live Clipboard Sync -->
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,8,0,0">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="&#x1F4CB; LIVE CLIPBOARD &amp; MEMO" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold"/>
                                            <Button Content="CLEAR" Click="ClearClipboard_Click" Style="{StaticResource NeonBtn}" HorizontalAlignment="Right" Padding="6,2" FontSize="9"/>
                                        </Grid>
                                        <Border Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="8" Padding="6" MinHeight="36" Margin="0,0,0,8">
                                            <TextBlock x:Name="CurrentClipboardText" Text="(Listening to clipboard...)" Foreground="{StaticResource TextDim}" FontSize="10.5" TextWrapping="Wrap" MaxHeight="34"/>
                                        </Border>

                                        <TextBlock Text="Quick Note &amp; Phone Beam:" Foreground="{StaticResource TextDim}" FontSize="9" FontWeight="Bold" Margin="0,0,0,3"/>
                                        <Border Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="8" Padding="2">
                                            <TextBox x:Name="QuickNoteBox" Height="38" Background="Transparent" Foreground="White" BorderThickness="0" Padding="4,2" FontSize="10.5" TextWrapping="Wrap" AcceptsReturn="True"/>
                                        </Border>
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="&#x1F4CB; COPY NOTE" Click="NoteCopy_Click" Style="{StaticResource NeonBtn}" Padding="6,3" FontSize="9" Margin="0,0,4,0"/>
                                            <Button Grid.Column="1" Content="&#x1F9F9; CLEAR" Click="NoteClear_Click" Style="{StaticResource NeonBtn}" Padding="6,3" FontSize="9" Margin="0,0,4,0"/>
                                            <Button Grid.Column="2" Content="&#x1F4F1; PUSH TO PHONE" Click="NoteSend_Click" Style="{StaticResource NeonBtn}" Padding="8,3" FontSize="9" FontWeight="Black" BorderBrush="{StaticResource AccentGreen}" Foreground="{StaticResource AccentGreen}" HorizontalAlignment="Right"/>
                                            <Button Grid.Column="3" Content="&#x1F50A; FIND PHONE" Click="FindPhone_Click" Style="{StaticResource NeonBtn}" Padding="7,3" FontSize="9" Margin="4,0,0,0" BorderBrush="{StaticResource AccentPurple}" Foreground="{StaticResource AccentPurple}"/>
                                            </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Bottom Row (Row 6): Activate Gaming Mode Button -->
                            <StackPanel Grid.Row="6" Margin="0,5,0,10">
                                <ToggleButton x:Name="GamingModeToggle" Click="GamingModeToggle_Click" Height="56" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="border" CornerRadius="16" BorderThickness="1.5" Background="#0E1A30" BorderBrush="#33BF5AF2">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="20" Color="#BF5AF2" ShadowDepth="0" Opacity="0.3"/>
                                                </Border.Effect>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#x1F3AE;" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="txt" Text="ACTIVATE MASTER GAMING MODE" Foreground="White" FontSize="14" FontWeight="Black"/>
                                                        <TextBlock x:Name="subtxt" Text="Unlock peak performance &amp; silence notifications" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1500D2FF"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#00D2FF"/>
                                                    <Setter TargetName="border" Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect BlurRadius="30" Color="#00D2FF" ShadowDepth="0" Opacity="0.6"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter TargetName="txt" Property="Text" Value="GAMING MODE ACTIVE"/>
                                                    <Setter TargetName="txt" Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                    <Setter TargetName="subtxt" Property="Text" Value="CPU/GPU priority boosted | Background tasks suspended"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <StackPanel x:Name="GamingOptionsPanel" Visibility="Collapsed" Margin="10,8,10,0" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="GamingStatusText" Text="Active - Optimizing..." Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold" Margin="0,0,15,0" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="CbHighPerformance" Content="High Performance Power Profile" Foreground="{StaticResource AccentGreen}" IsChecked="True" Margin="0,0,15,0" FontSize="11"/>
                                    <CheckBox x:Name="CbDND" Content="Silence Windows Toasts (DND)" Foreground="{StaticResource AccentGreen}" IsChecked="True" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 2. LIQUID MIRROR PANEL (Phone Screen on PC) -->
                        <!-- ============================================== -->
                        <Grid x:Name="MirrorPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Mirror Action Header -->
                            <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,18" Padding="14,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#x25C0; DASHBOARD" Click="StopMirror_Click" Style="{StaticResource NeonBtn}" Padding="10,5" Margin="0,0,12,0" FontSize="10.5" FontWeight="Bold"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F4F1; PHONE SCREEN MIRROR" Foreground="White" FontSize="15" FontWeight="Black"/>
                                            <TextBlock Text="Ultra Low-Latency Touch &amp; Display Hub" Foreground="{StaticResource TextDim}" FontSize="9"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Pill -->
                                    <Border Grid.Column="1" HorizontalAlignment="Center" CornerRadius="12" Background="#1500D2FF" BorderBrush="#3300D2FF" BorderThickness="1" Padding="12,5">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="STATUS: " Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock x:Name="MirrorHubStatusText" Text="Ready" Foreground="{StaticResource AccentBlue}" FontSize="10" FontWeight="Black"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Controls -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="MirrorStartBtn" Content="&#x25B6; START STREAM" Click="MirrorStartBtn_Click" Style="{StaticResource NeonBtn}" Padding="12,5" Margin="0,0,6,0" BorderBrush="{StaticResource AccentGreen}" Foreground="{StaticResource AccentGreen}" FontSize="10" FontWeight="Bold"/>
                                        <Button x:Name="MirrorStopBtn" Content="&#x25A0; STOP STREAM" Click="MirrorStopBtn_Click" Style="{StaticResource NeonBtn}" Padding="12,5" Margin="0,0,6,0" Visibility="Collapsed" BorderBrush="{StaticResource AccentRed}" Foreground="{StaticResource AccentRed}" FontSize="10" FontWeight="Bold"/>
                                        <Button Content="&#x1F504; ROTATE" Click="RotateMirror_Click" Style="{StaticResource NeonBtn}" Padding="10,5" Margin="0,0,6,0" FontSize="10" FontWeight="Bold"/>
                                        <Button Content="&#x1F4F8; SNAPSHOT" Click="SnapshotMirror_Click" Style="{StaticResource NeonBtn}" Padding="10,5" FontSize="10" FontWeight="Bold" BorderBrush="{StaticResource AccentPurple}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Physical Phone Cockpit Frame Container -->
                            <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,0,0,20">
                                <Border x:Name="MirrorFrameBorder" Width="320" Height="560" CornerRadius="32"
                                        Background="#050A14" BorderBrush="#1A2D4A" BorderThickness="2.5"
                                        ClipToBounds="True" AllowDrop="True" Drop="FilesPanel_Drop" DragOver="FilesPanel_DragOver">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="35" Color="#00D2FF" ShadowDepth="4" Opacity="0.25"/>
                                    </Border.Effect>
                                    <Grid>
                                        <!-- Mirrored Screen Surface -->
                                        <Image x:Name="MobileScreenImage" Stretch="Uniform" MouseLeftButtonDown="MobileScreen_MouseDown"/>

                                        <!-- Top Dynamic Island Pill Cutout -->
                                        <Border Width="96" Height="24" CornerRadius="12" Background="#EA050A14" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0" IsHitTestVisible="False">
                                            <Grid>
                                                <!-- Camera & FaceID Sensors -->
                                                <Ellipse Width="10" Height="10" Fill="#1AFFFFFF" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                                <Ellipse Width="7" Height="7" Fill="#3000D2FF" HorizontalAlignment="Right" Margin="0,0,16,0"/>
                                            </Grid>
                                        </Border>

                                        <!-- Waiting Overlay Status Text -->
                                        <StackPanel x:Name="MirrorPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="&#x1F4F1;" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock x:Name="MirrorStatusText" Text="Waiting for Mobile Stream..." Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Open PC Master App on phone and tap Mirror" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </StackPanel>

                                        <!-- Bottom Phone Home Indicator Bar -->
                                        <Border Width="110" Height="4" CornerRadius="2" Background="#4A5F80" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" IsHitTestVisible="False"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 3. AIRDROP & FILES PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="FilesPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="AIRDROP &amp; WIRELESS FILE HUB" FontSize="22" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="High-speed direct Wi-Fi beaming and phone storage sync" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Wireless File Hub Controls -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#x1F310; WIRELESS HUB:" Foreground="{StaticResource AccentBlue}" FontSize="11.5" FontWeight="Bold" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                        <Button x:Name="StartFileServerButton" Content="HUB ACTIVE (8099)" Click="StartFileServerButton_Click" Padding="12,5" FontSize="10.5" FontWeight="Bold" BorderBrush="{StaticResource AccentGreen}" Foreground="{StaticResource AccentGreen}">
                                            <Button.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource NeonBtn}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Tag" Value="Started">
                                                            <Setter Property="Background" Value="#2500FF88"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                                            <Setter Property="Content" Value="HUB ACTIVE (8099)"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Resources>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="&#x2795; UPLOAD FILE" Click="BrowseAndUploadFile_Click" Style="{StaticResource NeonBtn}" Padding="12,5" Margin="0,0,8,0" FontSize="10.5" FontWeight="Bold" BorderBrush="{StaticResource AccentBlue}"/>
                                        <Button Content="&#x1F4C1; OPEN FOLDER" Click="OpenSharedFolder_Click" Style="{StaticResource NeonBtn}" Padding="10,5" Margin="0,0,8,0" FontSize="10.5"/>
                                        <Button Content="&#x1F6E1; FIX FIREWALL" Click="FixFirewall_Click" Style="{StaticResource NeonBtn}" Padding="10,5" FontSize="10.5"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- AirDrop Drag & Drop Zone -->
                            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="20" AllowDrop="True" Drop="FilesPanel_Drop" DragOver="FilesPanel_DragOver" BorderBrush="#3300D2FF" Background="#0B1528">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#x1F4E1;" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                    <TextBlock Text="AirDrop Direct to Phone: Drag &amp; Drop Files Here" Foreground="White" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Files dropped here are automatically accessible on your connected device" Foreground="{StaticResource TextDim}" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Shared & Received Files Catalog -->
                            <Border Grid.Row="3" Style="{StaticResource CardBorderStyle}" MinHeight="260">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- Filter / Search Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="220"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="SHARED FILES CATALOG" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                        
                                        <!-- Search Input -->
                                        <Border Grid.Column="2" CornerRadius="10" Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="&#x1F50D; " FontSize="10" Foreground="{StaticResource TextDim}" VerticalAlignment="Center"/>
                                                <TextBox Grid.Column="1" x:Name="FilesSearchBox" TextChanged="FilesSearchBox_TextChanged" Background="Transparent" Foreground="White" BorderThickness="0" FontSize="11" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- Files List -->
                                    <ListBox x:Name="SharedFilesList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="White"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch"
                                             PreviewMouseLeftButtonDown="SharedFilesList_PreviewMouseLeftButtonDown"
                                             MouseMove="SharedFilesList_MouseMove">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#162744" BorderThickness="0,0,0,1" Padding="8,6" Margin="0,2">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="32"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Size}" Foreground="{StaticResource TextDim}" FontSize="9.5" Margin="0,1,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="OPEN" Click="OpenFile_Click" Tag="{Binding Path}" Style="{StaticResource NeonBtn}" Margin="0,0,6,0" Padding="10,4" FontSize="9.5" FontWeight="Bold"/>
                                                            <Button Content="DELETE" Click="DeleteFile_Click" Tag="{Binding Path}" Style="{StaticResource NeonBtn}" BorderBrush="{StaticResource AccentRed}" Foreground="{StaticResource AccentRed}" Padding="8,4" FontSize="9.5"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock x:Name="EmptyFilesText" Grid.Row="1" Text="No files shared yet. Drag &amp; drop files above or click UPLOAD FILE." Foreground="{StaticResource TextDeepDim}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="13"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 4. APP LIBRARY & REMOTE LAUNCHER PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="RemotePanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="COCKPIT APP LIBRARY &amp; LAUNCHER" FontSize="22" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="Categorized springboard launcher for Windows administration, productivity &amp; power" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="2">
                                <!-- Pod 1: System Management -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F6E0; SYSTEM &amp; ADMINISTRATION" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F4CA; Task Manager" Click="RemoteCmd_Click" Tag="taskmgr" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F4BB; Command Prompt" Click="RemoteCmd_Click" Tag="cmd" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x26A1; PowerShell" Click="RemoteCmd_Click" Tag="powershell" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F511; Regedit" Click="RemoteCmd_Click" Tag="regedit" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F50C; Device Manager" Click="RemoteCmd_Click" Tag="devmgmt" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F39B; Control Panel" Click="RemoteCmd_Click" Tag="control" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Pod 2: Productivity & Utilities -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x270E; PRODUCTIVITY &amp; TOOLS" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F9EE; Calculator" Click="RemoteCmd_Click" Tag="calc" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F4DD; Notepad" Click="RemoteCmd_Click" Tag="notepad" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x2702; Snipping Tool" Click="RemoteCmd_Click" Tag="snipping" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F4F8; Screenshot" Click="RemoteCmd_Click" Tag="screenshot" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x2328; On-Screen Keys" Click="RemoteCmd_Click" Tag="osk" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F3A8; MS Paint" Click="RemoteCmd_Click" Tag="paint" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Pod 3: Navigation & Folders -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F4C2; FOLDERS &amp; BROWSING" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F4C1; File Explorer" Click="RemoteCmd_Click" Tag="explorer" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F4E5; Downloads" Click="RemoteCmd_Click" Tag="downloads" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F4C4; Documents" Click="RemoteCmd_Click" Tag="documents" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F310; Web Browser" Click="RemoteCmd_Click" Tag="chrome" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Pod 4: Power & Security -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F512; POWER &amp; SECURITY" Foreground="{StaticResource AccentRed}" FontWeight="Bold" FontSize="12" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F512; Lock PC" Click="RemoteCmd_Click" Tag="lock" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F4A4; Sleep Mode" Click="RemoteCmd_Click" Tag="sleep" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x1F311; Screen Off" Click="RemoteCmd_Click" Tag="monoff" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10"/>
                                            <Button Content="&#x274C; Abort Shutdown" Click="RemoteCmd_Click" Tag="abort" Style="{StaticResource NeonBtn}" Margin="3" Padding="6,10" BorderBrush="{StaticResource AccentRed}"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 5. PRO OPTIMIZER & MAINTENANCE PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="MacrosPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="&#x26A1; COCKPIT PERFORMANCE &amp; OPTIMIZER" FontSize="22" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="1-Tap deep clean, memory defragmentation, network stack tuning &amp; audio repair" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}">
                                <UniformGrid Columns="3">
                                    <Button Click="Macro_Click" Tag="boostram" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F680;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="BOOST RAM" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Purge working set &amp; cache" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="Macro_Click" Tag="cleartemp" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F9F9;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="CLEAN TEMP FILES" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Remove %temp% &amp; junk" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="EmptyRecycleBin_Click" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F5D1;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="EMPTY TRASH" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Instant recycle bin purge" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="Macro_Click" Tag="flushdns" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F310;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="FLUSH DNS" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Reset resolver cache" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="Macro_Click" Tag="restartexp" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F504;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="RESTART EXPLORER" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Revive frozen taskbar" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="CaffeineToggle_Click" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x2615;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="CAFFEINE MODE" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Prevent system sleep" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="Macro_Click" Tag="toggledark" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F319;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="TOGGLE THEME" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Switch Dark / Light Mode" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="Macro_Click" Tag="audiofix" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x1F50A;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="AUDIO SUBSYSTEM FIX" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Restart audiosrv daemon" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>

                                    <Button Click="KillNotResponding_Click" Style="{StaticResource NeonBtn}" Margin="6" Padding="10,16" BorderBrush="{StaticResource AccentRed}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <TextBlock Text="&#x26A1;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                            <TextBlock Text="KILL FROZEN APPS" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentRed}" HorizontalAlignment="Center"/>
                                            <TextBlock Text="End unresponsive tasks" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </UniformGrid>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 6. MEDIA STUDIO & APPLE PLAYER PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="MediaPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="&#x1F3B5; COCKPIT MEDIA STUDIO &amp; PLAYER" FontSize="22" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="Tactile media playback controls, dynamic audio fader &amp; entertainment hubs" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="24">
                                <StackPanel>
                                    <!-- Now Playing Card Mockup -->
                                    <Grid Margin="0,0,0,24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="90" Height="90" CornerRadius="20" Background="#20BF5AF2" BorderBrush="#40BF5AF2" BorderThickness="1.5">
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="20" Color="#BF5AF2" ShadowDepth="0" Opacity="0.4"/>
                                            </Border.Effect>
                                            <TextBlock Text="&#x1F3A7;" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                            <Border HorizontalAlignment="Left" Background="#1800D2FF" CornerRadius="6" Padding="6,2" Margin="0,0,0,6">
                                                <TextBlock Text="WINDOWS AUDIO STREAM" Foreground="{StaticResource AccentBlue}" FontSize="9" FontWeight="Black"/>
                                            </Border>
                                            <TextBlock Text="Universal PC Media Controller" Foreground="White" FontSize="18" FontWeight="Black"/>
                                            <TextBlock Text="Spotify | YouTube | Browser | VLC Player" Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Transport Controls -->
                                    <UniformGrid Columns="3" Margin="0,0,0,20">
                                        <Button Content="&#x23EE; PREV TRACK" Click="RemoteCmd_Click" Tag="prev" Style="{StaticResource NeonBtn}" Margin="6" Height="54" FontSize="13" FontWeight="Bold"/>
                                        <Button Content="&#x23EF; PLAY / PAUSE" Click="RemoteCmd_Click" Tag="playpause" Style="{StaticResource NeonBtn}" Margin="6" Height="54" FontSize="14" FontWeight="Black" BorderBrush="{StaticResource AccentBlue}"/>
                                        <Button Content="&#x23ED; NEXT TRACK" Click="RemoteCmd_Click" Tag="next" Style="{StaticResource NeonBtn}" Margin="6" Height="54" FontSize="13" FontWeight="Bold"/>
                                    </UniformGrid>

                                    <!-- Volume Slider & Presets -->
                                    <Border Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,20">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="&#x1F50A; MASTER OUTPUT LEVEL" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="Global Audio Fader" Foreground="{StaticResource TextDim}" FontSize="9" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <UniformGrid Columns="5" Margin="0,0,0,8">
                                                <Button Content="100%" Click="VolumePreset_Click" Tag="100" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                                <Button Content="75%" Click="VolumePreset_Click" Tag="75" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                                <Button Content="50%" Click="VolumePreset_Click" Tag="50" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                                <Button Content="25%" Click="VolumePreset_Click" Tag="25" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                                <Button Content="&#x1F507; MUTE" Click="RemoteCmd_Click" Tag="mute" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10" BorderBrush="{StaticResource AccentRed}" Foreground="{StaticResource AccentRed}"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Media Launchers -->
                                    <Border Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="14" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="QUICK LAUNCH:" Foreground="{StaticResource AccentPurple}" FontSize="10.5" FontWeight="Black" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <UniformGrid Grid.Column="1" Columns="4">
                                                <Button Content="&#x1F7E2; Spotify" Click="RemoteCmd_Click" Tag="spotify" Style="{StaticResource NeonBtn}" Margin="2" Padding="4,6" FontSize="10.5"/>
                                                <Button Content="&#x1F534; YouTube" Click="LaunchWeb_Click" Tag="youtube" Style="{StaticResource NeonBtn}" Margin="2" Padding="4,6" FontSize="10.5"/>
                                                <Button Content="&#x1F7E0; Chrome Music" Click="RemoteCmd_Click" Tag="chrome" Style="{StaticResource NeonBtn}" Margin="2" Padding="4,6" FontSize="10.5"/>
                                                <Button Content="&#x1F39E; Media Player" Click="RemoteCmd_Click" Tag="cmd" Style="{StaticResource NeonBtn}" Margin="2" Padding="4,6" FontSize="10.5"/>
                                            </UniformGrid>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 7. MOBILE NOTIFICATIONS PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="NotificationsPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                                                    <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="MOBILE NOTIFICATION CENTER" FontSize="22" FontWeight="Black" Foreground="White"/>
                                    <TextBlock Text="Real-time push alerts, messaging sync &amp; instant replies from phone" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                                </StackPanel>
                                <Button Content="&#x1F9F9; CLEAR ALL" Click="ClearAllNotifications_Click" Style="{StaticResource NeonBtn}" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="12,5" FontSize="10.5" FontWeight="Bold"/>
                            </Grid>

                            <!-- Notification Cards Container -->
                            <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" MinHeight="340">
                                <Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                                        <ItemsControl x:Name="NotificationList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="16" Margin="0,0,0,10" Padding="14">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                                    <Border Background="#1500D2FF" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                                                        <TextBlock Text="{Binding AppName}" Foreground="{StaticResource AccentBlue}" FontSize="10" FontWeight="Black"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Content}" Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,8"/>
                                                                
                                                                <!-- Inline Quick Reply -->
                                                                <Grid x:Name="ReplyPanel" Visibility="{Binding CanReply, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBox x:Name="ReplyBox" Background="#0B1528" Foreground="White" BorderBrush="#1A2D4A" BorderThickness="1" Padding="8,5" Tag="{Binding Id}" KeyDown="ReplyBox_KeyDown" FontSize="11.5"/>
                                                                    <Button Grid.Column="1" Content="SEND" Click="NotificationReply_Click" Style="{StaticResource NeonBtn}" Padding="12,5" Margin="6,0,0,0" FontSize="10.5" FontWeight="Bold" BorderBrush="{StaticResource AccentBlue}"/>
                                                                </Grid>
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="&#x2715;" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderThickness="0" VerticalAlignment="Top" Click="DismissNotification_Click" Tag="{Binding Id}" Cursor="Hand" FontSize="13"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Empty Placeholder -->
                                    <StackPanel x:Name="NoNotifText" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible">
                                        <TextBlock Text="&#x1F514;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="No active notifications" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Notifications from your phone will appear here in real-time" Foreground="{StaticResource TextDim}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 8. SYSTEM HARDWARE & POWER PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="SystemPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="&#x2699; HARDWARE &amp; POWER STUDIO" FontSize="22" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="Active power scheme, display brightness calibration &amp; power controls" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Top">
                                <!-- Power Plan Card -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x26A1; POWER PLAN MANAGEMENT" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F50B; SAVER" Click="PowerPlan_Click" Tag="saver" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="&#x2696; BALANCED" Click="PowerPlan_Click" Tag="balanced" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="&#x26A1; HIGH PERF" Click="PowerPlan_Click" Tag="high" Style="{StaticResource NeonBtn}" Margin="3" Grid.ColumnSpan="2"/>
                                            <Button Content="&#x1F680; ULTIMATE" Click="PowerPlan_Click" Tag="ultimate" Style="{StaticResource NeonBtn}" Margin="3" Grid.ColumnSpan="2" BorderBrush="{StaticResource AccentPurple}"/>
                                        </UniformGrid>
                                        <TextBlock x:Name="CurrentPowerPlanText" Text="Current: Detecting..." Foreground="{StaticResource TextDim}" FontSize="11" Margin="0,12,0,0" TextAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Brightness Studio Card -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x2600; DISPLAY BRIGHTNESS" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <TextBlock x:Name="BrightnessValueText" Text="100%" Foreground="White" FontSize="36" FontWeight="Black" HorizontalAlignment="Center" Margin="0,4"/>
                                        <Slider x:Name="BrightnessSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100" Value="100" ValueChanged="BrightnessSlider_Changed" Margin="0,8,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F506; INCREASE" Click="BrightnessUp_Click" Style="{StaticResource NeonBtn}" Margin="2"/>
                                            <Button Content="&#x1F505; DECREASE" Click="BrightnessDown_Click" Style="{StaticResource NeonBtn}" Margin="2"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Sleep & Shutdown Suite -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x23F1; SHUTDOWN TIMERS" Foreground="{StaticResource AccentRed}" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="3">
                                            <Button Content="15M" Click="ShutdownTimer_Click" Tag="15" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="30M" Click="ShutdownTimer_Click" Tag="30" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="1H" Click="ShutdownTimer_Click" Tag="60" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="2H" Click="ShutdownTimer_Click" Tag="120" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="4H" Click="ShutdownTimer_Click" Tag="240" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="ABORT" Click="ShutdownTimer_Click" Tag="0" Style="{StaticResource NeonBtn}" Margin="3" BorderBrush="{StaticResource AccentRed}" Foreground="{StaticResource AccentRed}"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>

                                <!-- Display & Power Actions -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F512; DISPLAY &amp; SESSION" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="&#x1F311; SCREEN OFF" Click="RemoteCmd_Click" Tag="monoff" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="&#x1F512; LOCK PC" Click="RemoteCmd_Click" Tag="lock" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="&#x1F4A4; SLEEP" Click="RemoteCmd_Click" Tag="sleep" Style="{StaticResource NeonBtn}" Margin="3"/>
                                            <Button Content="&#x1F4F8; SCREENSHOT" Click="RemoteCmd_Click" Tag="screenshot" Style="{StaticResource NeonBtn}" Margin="3"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </Grid>

                        <!-- ============================================== -->
                        <!-- 9. PREFERENCES & LOGS PANEL -->
                        <!-- ============================================== -->
                        <Grid x:Name="SettingsPanel" Visibility="Collapsed" Style="{StaticResource PanelStyle}">
                            <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                                <TextBlock Text="&#x1F6E0; PREFERENCES &amp; SYSTEM CONFIG" FontSize="22" FontWeight="Black" Foreground="White"/>
                                <TextBlock Text="Configure daemon behavior, wireless parameters &amp; inspect real-time log stream" FontSize="10.5" Foreground="{StaticResource TextDim}"/>
                            </StackPanel>

                            <UniformGrid Grid.Row="1" Columns="2" VerticalAlignment="Top">
                                <!-- Behavior Settings -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="APP BEHAVIOR &amp; DAEMON" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <Grid Margin="0,6">
                                            <TextBlock Text="Run on Windows Startup" Foreground="White" FontSize="12.5"/>
                                            <ToggleButton x:Name="AutoStartToggle" Visibility="Collapsed"/>
                                            <ToggleButton x:Name="SettingsAutoStart" Style="{StaticResource FlatToggle}" HorizontalAlignment="Right" IsChecked="{Binding IsChecked, ElementName=AutoStartToggle, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,6">
                                            <TextBlock Text="Minimize to System Tray" Foreground="White" FontSize="12.5"/>
                                            <ToggleButton x:Name="TrayToggle" Visibility="Collapsed"/>
                                            <ToggleButton x:Name="SettingsTray" Style="{StaticResource FlatToggle}" HorizontalAlignment="Right" IsChecked="{Binding IsChecked, ElementName=TrayToggle, Mode=TwoWay}"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,6">
                                            <TextBlock Text="Hardware Monitoring Sensors" Foreground="White" FontSize="12.5"/>
                                            <ToggleButton x:Name="MonitoringToggle" Style="{StaticResource FlatToggle}" HorizontalAlignment="Right" IsChecked="True" Click="MonitoringToggle_Click"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,6">
                                            <TextBlock Text="Caffeine Mode (Prevent Sleep)" Foreground="White" FontSize="12.5"/>
                                            <ToggleButton x:Name="CaffeineToggle" Style="{StaticResource FlatToggle}" HorizontalAlignment="Right" Click="CaffeineToggle_Click"/>
                                        </Grid>
                                        <Grid Margin="0,10,0,6">
                                            <TextBlock Text="Compact Mode (Mini Widget)" Foreground="White" FontSize="12.5"/>
                                            <ToggleButton x:Name="CompactModeToggle" Style="{StaticResource FlatToggle}" HorizontalAlignment="Right" Click="CompactModeToggle_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Telemetry & Diagnostics -->
                                <Border Style="{StaticResource CardBorderStyle}" Margin="6">
                                    <StackPanel>
                                        <TextBlock Text="TELEMETRY &amp; HARDWARE SENSING" Foreground="{StaticResource AccentOrange}" FontWeight="Bold" Margin="0,0,0,15"/>
                                        <TextBlock Text="Sensor Polling Frequency (Seconds):" Foreground="White" FontSize="12" Margin="0,0,0,8"/>
                                        <Slider x:Name="UpdateRateSlider" Style="{StaticResource GlassSlider}" Minimum="1" Maximum="10" Value="2" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <Button Content="&#x1F9F9; CLEAN SYSTEM TEMP" Click="Macro_Click" Tag="cleartemp" Style="{StaticResource NeonBtn}" Margin="0,18,0,0"/>
                                        <Button x:Name="StressTestBtn" Content="&#x26A1; RUN HARDWARE STRESS TEST" Click="StressTest_Click" Style="{StaticResource NeonBtn}" Margin="0,10,0,0" BorderBrush="{StaticResource AccentRed}" Foreground="{StaticResource AccentRed}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Live Activity Log -->
                            <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="6,15,6,10" Height="220">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,10">
                                        <TextBlock Text="ACTIVITY &amp; NETWORK CONSOLE LOG" Foreground="{StaticResource AccentPurple}" FontWeight="Bold" FontSize="12"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="&#x1F4CB; COPY LOG" Click="CopyLog_Click" Style="{StaticResource NeonBtn}" Margin="0,0,8,0" Padding="10,3" FontSize="9.5"/>
                                            <Button Content="&#x1F9F9; CLEAR" Click="ClearLog_Click" Style="{StaticResource NeonBtn}" Padding="10,3" FontSize="9.5"/>
                                        </StackPanel>
                                    </Grid>
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl x:Name="LogList" Background="#050A14">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                                        <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource AccentBlue}" FontSize="10" FontFamily="Consolas" Width="65"/>
                                                        <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextDim}" FontSize="10" FontFamily="Consolas" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <!-- Dedicated Mini Mode Container (Compact Widget) -->
            <ScrollViewer x:Name="MiniModeContainer" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          CanContentScroll="False"
                          PanningMode="VerticalOnly"
                          PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                          Margin="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Mini Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#00D2FF" Offset="0"/>
                                        <GradientStop Color="#BF5AF2" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock Text="PC" Foreground="White" FontSize="12" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="PC MASTER" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Border Background="#0E1A30" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="6" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="MINI" Foreground="{StaticResource AccentBlue}" FontSize="9" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>

                        <!-- Mini Controls -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="&#x1F5D6;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource AccentBlue}" BorderThickness="0" Width="32" Height="26" Click="CompactModeBtn_Click" ToolTip="Expand to Full UI" Cursor="Hand"/>
                            <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource TextDim}" BorderThickness="0" Width="30" Height="26" Click="MinimizeButton_Click" ToolTip="Minimize" Cursor="Hand"/>
                            <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderThickness="0" Width="30" Height="26" Click="CloseButton_Click" ToolTip="Close" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>

                    <!-- Status & IP Pill -->
                    <Border Grid.Row="1" Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionIndicatorMini" Width="8" Height="8" Fill="{StaticResource AccentRed}" Margin="0,0,8,0">
                                <Ellipse.Effect>
                                        <DropShadowEffect x:Name="ConnectionGlowMini" BlurRadius="10" Color="#FF453A" ShadowDepth="0" Opacity="0.8"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="DeviceNameTextMini" Text="NOT CONNECTED" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="LocalIpTextMini" Text="127.0.0.1:8099" Foreground="{StaticResource AccentBlue}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 4 Telemetry Cards (2x2 Grid) -->
                    <UniformGrid Grid.Row="2" Columns="2" Margin="0,0,0,12">
                        <!-- CPU Card -->
                        <Border Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="14" Padding="10" Margin="3">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="CPU" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="CpuTempTextMini" Text="--&#x00B0;C" Foreground="{StaticResource TextDim}" FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="CpuUsageTextMini" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="CpuBarMini" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentBlue}" Background="#13223B" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- GPU Card -->
                        <Border Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="14" Padding="10" Margin="3">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="GPU" Foreground="{StaticResource AccentPurple}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="GpuTempTextMini" Text="--&#x00B0;C" Foreground="{StaticResource TextDim}" FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="GpuUsageTextMini" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="GpuBarMini" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentPurple}" Background="#13223B" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM Card -->
                        <Border Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="14" Padding="10" Margin="3">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="RAM" Foreground="{StaticResource AccentOrange}" FontSize="11" FontWeight="Bold"/>
                                        <TextBlock x:Name="RamAvailTextMini" Text="-- Free" Foreground="{StaticResource TextDim}" FontSize="10" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RamUsageTextMini" Text="0%" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="RamBarMini" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentOrange}" Background="#13223B" BorderThickness="0"/>
                            </StackPanel>
                        </Border>

                        <!-- FAN Card -->
                        <Border Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="14" Padding="10" Margin="3">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="FAN" Foreground="{StaticResource AccentGreen}" FontSize="11" FontWeight="Bold"/>
                                    <TextBlock x:Name="FanSpeedTextMini" Text="0 RPM" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="FanBarMini" Height="4" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentGreen}" Background="#13223B" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Quick Action Buttons -->
                    <Border Grid.Row="3" Background="#0B1528" BorderBrush="#1A2D4A" BorderThickness="1" CornerRadius="14" Padding="8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="QUICK ACTIONS" Foreground="{StaticResource TextDim}" FontSize="9" FontWeight="Bold" Margin="4,0,0,6"/>
                            <UniformGrid Columns="4">
                                <Button Content="LOCK" Click="RemoteCmd_Click" Tag="lock" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                <Button Content="SLEEP" Click="RemoteCmd_Click" Tag="sleep" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                <Button Content="MUTE" Click="RemoteCmd_Click" Tag="mute" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                                <Button Content="BOOST" Click="Macro_Click" Tag="boostram" Style="{StaticResource NeonBtn}" Padding="4,6" Margin="2" FontSize="10"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Gaming Mode Toggle (Mini) -->
                    <ToggleButton Grid.Row="4" x:Name="GamingModeToggleMini" Click="GamingModeToggle_Click" Height="44" Cursor="Hand" Margin="0,0,0,10">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="miniBorder" CornerRadius="12" BorderThickness="1" BorderBrush="#1A2D4A" Background="#0B1528">
                                    <Grid VerticalAlignment="Center" Margin="12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#x1F3AE;" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" x:Name="miniGamingText" Text="GAMING MODE" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Grid.Column="2" x:Name="miniPill" CornerRadius="6" Background="#13223B" Padding="6,2">
                                            <TextBlock x:Name="miniPillText" Text="OFF" Foreground="{StaticResource TextDim}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="miniBorder" Property="Background" Value="{StaticResource NeonBtnGradient}"/>
                                        <Setter TargetName="miniBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                        <Setter TargetName="miniPill" Property="Background" Value="#FFFFFF"/>
                                        <Setter TargetName="miniPillText" Property="Text" Value="ACTIVE"/>
                                        <Setter TargetName="miniPillText" Property="Foreground" Value="#050A14"/>
                                        <Setter TargetName="miniGamingText" Property="Text" Value="GAMING OPTIMIZED"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <!-- Wireless Hub & Pairing Row (Mini) -->
                    <Grid Grid.Row="5" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="StartFileServerButtonMini" Content="START HUB" Click="StartFileServerButton_Click" Padding="8,8" FontSize="11" Margin="0,0,6,0">
                            <Button.Resources>
                                <Style TargetType="Button" BasedOn="{StaticResource NeonBtn}">
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="Started">
                                            <Setter Property="Background" Value="#3032D74B"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentGreen}"/>
                                            <Setter Property="Content" Value="HUB ACTIVE (8099)"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Grid.Column="1" Content="&#x1F4F1; QR" Click="ShowPairingQR_Click" Style="{StaticResource NeonBtn}" Padding="12,8" FontSize="11" ToolTip="Pair Mobile Device"/>
                    </Grid>
                </Grid>
            </ScrollViewer>

            <!-- Desktop Notification Toast Banner (Bottom-Right) -->
            <Border x:Name="DesktopNotifToast" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,24" CornerRadius="16" Width="360" Visibility="Collapsed"
                    Background="#F507101F" BorderBrush="#3300D2FF" BorderThickness="1.5">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" Color="#00D2FF" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- App Name & Dismiss -->
                    <Grid Grid.Row="0">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1500D2FF" CornerRadius="6" Padding="6,2" Margin="0,0,8,0">
                                <TextBlock x:Name="ToastAppName" Text="PHONE MESSAGE" Foreground="{StaticResource AccentBlue}" FontSize="10" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="NEW NOTIFICATION" Foreground="{StaticResource TextDim}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="&#x2715;" Click="CloseToast_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextDim}" BorderThickness="0" Cursor="Hand" FontSize="12"/>
                    </Grid>

                    <!-- Title (Sender) -->
                    <TextBlock Grid.Row="1" x:Name="ToastTitle" Text="Sender Name" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,8,0,2"/>

                    <!-- Content (Message) -->
                    <TextBlock Grid.Row="2" x:Name="ToastContent" Text="Message preview..." Foreground="{StaticResource TextDim}" FontSize="12" TextWrapping="Wrap" MaxHeight="60" Margin="0,0,0,10"/>

                    <!-- Inline Reply Box -->
                    <Grid Grid.Row="3" x:Name="ToastReplyGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ToastReplyBox" Background="#0B1528" Foreground="White" BorderBrush="#1A2D4A" BorderThickness="1" Padding="8,6" FontSize="12" KeyDown="ToastReplyBox_KeyDown"/>
                        <Button Grid.Column="1" Content="REPLY" Click="ToastReply_Click" Style="{StaticResource NeonBtn}" Padding="12,6" Margin="6,0,0,0" FontSize="11" FontWeight="Bold"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Title Bar Buttons (Standard Mode) -->
            <StackPanel x:Name="FullTitleBarButtons" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                <Button x:Name="CompactModeBtn" Content="&#xE740;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource TextDim}" BorderThickness="0" Width="36" Height="28" Click="CompactModeBtn_Click" ToolTip="Switch to Mini Mode (Compact Widget)" Cursor="Hand"/>
                <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource TextDim}" BorderThickness="0" Width="36" Height="28" Click="MinimizeButton_Click" ToolTip="Minimize" Cursor="Hand"/>
                <Button Content="&#x1F5D6;" Background="Transparent" Foreground="{StaticResource TextDim}" BorderThickness="0" Width="36" Height="28" Click="MaximizeButton_Click" ToolTip="Maximize / Restore" Cursor="Hand"/>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Background="Transparent" Foreground="{StaticResource AccentRed}" BorderThickness="0" Width="36" Height="28" Click="CloseButton_Click" ToolTip="Close" Cursor="Hand"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
