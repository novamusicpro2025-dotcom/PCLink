<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#90000000" />
        </shape>
    </item>
    <item android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient android:angle="270" android:startColor="#F0090E17" android:centerColor="#EA060910" android:endColor="#E6030508" />
            <stroke android:width="1dp" android:color="#24304A66" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <corners android:radius="19dp" />
            <gradient android:angle="270" android:startColor="#1A00D2FF" android:endColor="#0000D2FF" />
        </shape>
    </item>
</layer-list>
