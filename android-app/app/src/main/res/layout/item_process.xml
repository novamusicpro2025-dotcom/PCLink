<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/card_pod_bg"
    android:paddingHorizontal="10dp">

    <FrameLayout
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:background="@drawable/badge_glow_cyan"
        android:layout_marginEnd="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_cpu_chip"
            app:tint="#00D2FF" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvProcName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="chrome.exe"
        android:textColor="#FFFFFF"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <Button
        android:id="@+id/btnKillProc"
        android:layout_width="64dp"
        android:layout_height="28dp"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:includeFontPadding="false"
        android:text="KILL"
        android:textColor="#FF453A"
        android:textSize="10sp"
        android:textStyle="bold"
        android:background="@drawable/key_btn_bg" />
</LinearLayout>
