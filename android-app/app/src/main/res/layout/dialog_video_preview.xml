<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050810">

    <!-- Top Action Bar -->
    <LinearLayout
        android:id="@+id/llVideoHeader"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:background="#151E2E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <ImageButton
            android:id="@+id/btnCloseVideoPreview"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/key_btn_bg"
            android:src="@drawable/ic_back_nav"
            app:tint="#FFFFFF"
            android:contentDescription="Close Preview" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvVideoPreviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Video Player"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="middle" />

            <TextView
                android:id="@+id/tvVideoPreviewSize"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Streaming live from PC"
                android:textColor="#00FF88"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Video View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/llVideoHeader"
        android:layout_above="@+id/llVideoBottomBar">

        <VideoView
            android:id="@+id/vvVideoPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <ProgressBar
            android:id="@+id/pbVideoBuffering"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:indeterminateTint="#00FF88" />
    </FrameLayout>

    <!-- Bottom Actions Bar -->
    <LinearLayout
        android:id="@+id/llVideoBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#151E2E"
        android:orientation="vertical"
        android:padding="14dp">

        <Button
            android:id="@+id/btnDownloadVideo"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="⬇ DOWNLOAD VIDEO TO PHONE"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/btn_connect_bg" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Downloads full video file to phone storage"
            android:textColor="#8A9BB5"
            android:textSize="10sp"
            android:layout_marginTop="5dp" />
    </LinearLayout>

</RelativeLayout>
