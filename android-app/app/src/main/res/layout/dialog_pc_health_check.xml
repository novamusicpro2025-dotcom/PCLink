<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_pod_bg"
    android:padding="16dp">

    <!-- Top Bar: Shield Icon, Title, and Close Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/badge_glow_green"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:id="@+id/diagHeaderShield"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_shield_auth"
                    app:tint="#00FF88"
                    android:contentDescription="Shield" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PCLink System Health"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiagHostSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-time Hardware &amp; Network Diagnostics"
                    android:textColor="#6E829F"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDiagClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_more_dots"
            app:tint="#8A9BB5"
            android:contentDescription="Close" />
    </RelativeLayout>

    <!-- Scan Progress Bar (Visible during scan) -->
    <ProgressBar
        android:id="@+id/pbDiagScanning"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:indeterminateTint="#00FF88"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <!-- Scrollable Diagnostic Report Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingEnd="2dp">

            <!-- Hero Score Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_telemetry_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OVERALL HEALTH RATING"
                            android:textColor="#6E829F"
                            android:textSize="10.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiagScoreText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="98%"
                            android:textColor="#00FF88"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDiagGradeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYSTEM OPTIMAL"
                            android:textColor="#00FF88"
                            android:textSize="12.5sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Circular Progress Meter -->
                    <com.pcmaster.mobile.CircularMetricView
                        android:id="@+id/cmvDiagHealth"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        app:metricAccentColor="#00FF88"
                        app:metricTrackColor="#141E33" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/tvDiagSummaryDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="All monitored hardware sensors, thermals, and memory buffers are within peak operational parameters."
                    android:textColor="#A0B3D0"
                    android:textSize="11.5sp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <!-- 1. CPU & THERMAL HEALTH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_cpu_chip"
                            app:tint="#00D2FF"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CPU &amp; Thermals"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiagCpuStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="NORMAL"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDiagCpuLoadVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Load: 12%"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagCpuTempVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Temp: 44 °C"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagCpuThrottleVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Throttle: None"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 2. MEMORY & RAM INTEGRITY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_ram_chip"
                            app:tint="#00FF88"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="RAM &amp; Memory Pressure"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiagRamStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="HEALTHY"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDiagRamUsedVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Used: 5.6 / 16.0 GB (35%)"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagRamFreeVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available: 10.4 GB"
                        android:textColor="#00D2FF"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 3. STORAGE & DISK HEALTH -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_storage_disk"
                            app:tint="#FF9F0A"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="System Storage &amp; Disk"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiagDiskStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="AMPLE SPACE"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDiagDiskUsedVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Storage: 180 / 512 GB"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagDiskFreeVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="332 GB Free"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 4. NETWORK & LAN LATENCY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_wifi_symbol"
                            app:tint="#00D2FF"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="LAN Connection &amp; Latency"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiagLanStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="FAST"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDiagLanPingVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Ping: 8 ms"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagLanThroughputVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Up 0.1 MB/s • Down 1.4 MB/s"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- 5. POWER, BATTERY & UPTIME -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_glass_bg"
                android:orientation="vertical"
                android:padding="12dp"
                android:layout_marginBottom="8dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_battery_status"
                            app:tint="#FF9F0A"
                            android:layout_marginEnd="6dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Power, Uptime &amp; OS"
                            android:textColor="#FFFFFF"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvDiagPowerStatusPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="AC POWER"
                        android:textColor="#00FF88"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvDiagUptimeVal"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Uptime: 14h 22m"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvDiagHostVal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DESKTOP-WIN"
                        android:textColor="#A0B3D0"
                        android:textSize="11sp"
                        android:gravity="end" />
                </LinearLayout>
            </LinearLayout>

            <!-- Issues / Recommendations Container -->
            <LinearLayout
                android:id="@+id/containerDiagIssues"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/badge_glow_green"
                android:orientation="vertical"
                android:padding="10dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvDiagIssuesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✅ Diagnostic Status: All Systems Clean"
                    android:textColor="#00FF88"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDiagIssuesDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No bottlenecks, thermal throttling, or critical memory pressure detected on host PC."
                    android:textColor="#A0B3D0"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom Buttons: Re-scan and Close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button
            android:id="@+id/btnDiagRefresh"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="🔄 Re-Scan Health"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_connect_bg"
            android:layout_marginEnd="6dp" />

        <Button
            android:id="@+id/btnDiagDone"
            android:layout_width="100dp"
            android:layout_height="48dp"
            android:text="Done"
            android:textColor="#A0B3D0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_scan_bg"
            android:layout_marginStart="6dp" />
    </LinearLayout>

</LinearLayout>
