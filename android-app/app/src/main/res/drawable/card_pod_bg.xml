<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#3500D2FF">
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#90000000" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="270" android:startColor="#F4080D15" android:endColor="#EC04070B" />
                    <stroke android:width="1dp" android:color="#241E2F45" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
