<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#55FFFFFF">
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <solid android:color="#72004986" />
                </shape>
            </item>
            <item android:bottom="4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="16dp" />
                    <gradient android:angle="0" android:startColor="#00D2FF" android:centerColor="#008EF0" android:endColor="#0062FE" />
                    <stroke android:width="1dp" android:color="#AA92F4FF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
